# ============================================
# Forest Vitality - Backend Environment Variables
# ============================================
# Copy this file to .env for local development
# Never commit .env to version control!

# --------------------------------------------
# Copernicus/Sentinel Hub Configuration
# --------------------------------------------
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# --------------------------------------------
# MinIO Configuration
# --------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=sentinel-bands

# --------------------------------------------
# OpenSearch Configuration
# --------------------------------------------
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false

# --------------------------------------------
# Azure OpenAI Configuration
# --------------------------------------------
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_ENDPOINT=https://scchatbot-forestvitalityindex.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
# Comma-separated list of allowed origins
# Development: http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173
# Production: https://your-production-domain.com
CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------
# Keycloak Configuration
# --------------------------------------------
# Base URL of the Keycloak server
# Development: http://localhost:8080
# Production: http://keycloak:8080 (Docker internal) or https://auth.yourdomain.com
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=geo-platform
KEYCLOAK_CLIENT_ID=geo-platform-backend

# Comma-separated Keycloak client IDs to check for resource_access roles
KEYCLOAK_RESOURCE_CLIENT_IDS=forest-vitality,geo-platform-backend

# Optional: Override derived URLs if your setup differs
# KEYCLOAK_ISSUER=http://localhost:8080/realms/geo-platform
# KEYCLOAK_JWKS_URL=http://localhost:8080/realms/geo-platform/protocol/openid-connect/certs

# --------------------------------------------
# AWS / S3 Configuration
# --------------------------------------------
# Default region for S3-compatible storage (MinIO)
AWS_DEFAULT_REGION=us-east-1