# ==================================
# Forest Vitality - Infrastructure Environment Variables
# ==================================
# Copy this file to .env for local development.
# For production, use .env.prod in this directory.
# Update all passwords with strong values for production!

# --------------------------------------------
# Keycloak Admin
# --------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_strong_password

# --------------------------------------------
# Keycloak Database (Postgres)
# --------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change_me_strong_password

# --------------------------------------------
# MinIO / S3 Storage
# --------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_strong_password
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=change_me_strong_password
AWS_DEFAULT_REGION=us-east-1
