# ==================================
# Forest Vitality - Production Secrets Example
# ==================================
# Copy this file to .env.prod in this directory for production deployment
# Update all passwords and secrets with strong values!

# --------------------------------------------
# Keycloak Admin
# --------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_strong_password

# --------------------------------------------
# Keycloak Database (Postgres)
# --------------------------------------------
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change_me_strong_password

# --------------------------------------------
# MinIO / S3 Storage
# --------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change_me_strong_password
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=change_me_strong_password
MINIO_BUCKET=forest-vitality

# --------------------------------------------
# Service URLs (Internal Docker Network)
# --------------------------------------------
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=geo-platform
KEYCLOAK_CLIENT_ID=geo-platform-backend
MINIO_ENDPOINT=minio:9000
TITILER_URL=http://titiler:8000

# --------------------------------------------
# CORS Configuration
# --------------------------------------------
# Comma-separated allowed origins for the backend API
# Production: use your actual frontend domain
CORS_ORIGINS=http://frontend:80

# --------------------------------------------
# Keycloak Resource Client IDs
# --------------------------------------------
# Comma-separated Keycloak client IDs to check for resource_access roles
KEYCLOAK_RESOURCE_CLIENT_IDS=forest-vitality,geo-platform-backend

# --------------------------------------------
# AWS / S3 Configuration
# --------------------------------------------
AWS_DEFAULT_REGION=us-east-1
