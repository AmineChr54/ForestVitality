# ============================================
# Forest Vitality - Frontend Production Variables
# ============================================
# This file is used during the production build
# Values are baked into the static files at build time

# --------------------------------------------
# API Configuration
# --------------------------------------------
# Use relative path for Nginx proxy
VITE_API_BASE_URL=/api

# --------------------------------------------
# Keycloak Configuration
# --------------------------------------------
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=geo-platform
VITE_KEYCLOAK_CLIENT_ID=geo-platform-backend

# --------------------------------------------
# TiTiler Configuration
# --------------------------------------------
# If titiler is proxied via nginx
VITE_TITILER_URL=/titiler
