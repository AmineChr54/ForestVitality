# ============================================
# Forest Vitality - Frontend Environment Variables
# ============================================
# Copy this file to .env.local for local development
# Never commit .env.local to version control!

# --------------------------------------------
# API Configuration
# --------------------------------------------
# Base URL for the backend API
# Development: http://localhost:8000
# Production: https://api.yourproduction.com
VITE_API_BASE_URL=http://localhost:8000

# --------------------------------------------
# Map Configuration
# --------------------------------------------
# Map tile provider URL
# Default: OpenStreetMap tiles
# For production, consider using Mapbox, Stadia, or other providers
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# --------------------------------------------
# Sentinel API Configuration (Optional)
# --------------------------------------------
# API key for Sentinel Hub (if frontend needs direct access)
# Note: Backend handles most Sentinel API auth, this is optional
VITE_SENTINEL_API_KEY=

# --------------------------------------------
# Feature Flags (Optional)
# --------------------------------------------
# Enable debug mode for additional logging
VITE_DEBUG_MODE=false

# --------------------------------------------
# Frontend Base URL (needed for Keycloak redirect)
# --------------------------------------------
VITE_APP_BASE_URL=http://localhost:5173

# --------------------------------------------
# Keycloak Configuration
# --------------------------------------------
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=geo-platform
VITE_KEYCLOAK_CLIENT_ID=geo-platform-backend

# --------------------------------------------
# TiTiler Configuration
# --------------------------------------------
# TiTiler tile server URL for vegetation index overlays
# Development: http://localhost:8082
# Production: /titiler (proxied via Nginx)
VITE_TITILER_URL=http://localhost:8082
